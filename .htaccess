RewriteEngine On
Options -Indexes

# ==================== REDIRECT .html → route propre ====================
RewriteRule ^account\.html$ /account [R=301,L]
RewriteRule ^admin\.html$ /admin [R=301,L]
RewriteRule ^delivery\.html$ /delivery [R=301,L]
RewriteRule ^kitchen\.html$ /kitchen [R=301,L]
RewriteRule ^track\.html$ /track [R=301,L]

# ==================== API ====================
RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

# ==================== FAVICON ====================
RewriteCond %{REQUEST_URI} ^/favicon\.ico$
RewriteRule ^ /public/favicon.ico [L]

# ==================== ROBOTS.TXT ====================
RewriteCond %{REQUEST_URI} ^/robots\.txt$
RewriteRule ^ /public/robots.txt [L]

# ==================== ASSETS STATIQUES ====================
RewriteRule ^(assets/.+)$ public/$1 [L]

# ==================== PAGES HTML ====================
RewriteRule ^track.*$ public/track.html [L]
RewriteRule ^account$ public/account.html [L]
RewriteRule ^admin$ public/admin.html [L]
RewriteRule ^delivery$ public/delivery.html [L]
RewriteRule ^kitchen$ public/kitchen.html [L]

# ==================== SPA FALLBACK ====================
RewriteRule ^manifest\.json$ public/manifest.json [L]
RewriteRule ^sw\.js$ public/sw.js [L]
RewriteRule ^(.*)$ public/index.html [L]