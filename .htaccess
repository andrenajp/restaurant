RewriteEngine On

# API (toutes les routes API, y compris les nouvelles /admin/users/*/password, etc.)
RewriteRule ^api(/.*)?$ api/index.php [QSA,L]

# Routes HTML spécifiques
RewriteRule ^account$ public/account.html [L]
RewriteRule ^admin$ public/admin.html [L]          # ← Votre admin
RewriteRule ^delivery$ public/delivery.html [L]
RewriteRule ^kitchen$ public/kitchen.html [L]
RewriteRule ^track$ public/track.html [L]

# Assets statiques
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(assets/.+|manifest\.json|sw\.js|.*\.html)$ public/$1 [L]

# SPA fallback pour les autres routes
RewriteRule ^$ public/index.html [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ public/index.html [L]